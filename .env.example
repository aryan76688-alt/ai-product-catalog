# AI Provider Selection: 'openai' or 'gemini'
AI_PROVIDER=openai

# OpenAI API Key
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# Database Connection URL (PostgreSQL for Production/Railway, or SQLite for local dev)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for Railway:
# DATABASE_URL="postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway"

# Storage Settings
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
# For S3 / R2 (Optional):
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=catalog-images
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key

# Application Settings
PORT=3000
MAX_UPLOAD_SIZE_MB=25
MAX_BATCH_SIZE=500
NODE_ENV=development
